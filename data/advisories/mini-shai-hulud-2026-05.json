  "detection_rationale": [
    "Confirmed compromised package versions may have been removed from registries, preventing artifact fetch or diff generation.",
    "PyPI samples used import-time Python execution to download transformers.pyz into /tmp and execute it with python3.",
    "npm samples used lifecycle hooks and staged JavaScript such as setup.mjs and router_init.js to harvest credentials and target GitHub Actions/OIDC material."
  ],
  "remediation": [
    "Block the listed package versions in package managers, CI allowlists, lockfile policy, and artifact proxies.",
    "Rotate credentials exposed to affected build hosts, developer workstations, package manager tokens, GitHub tokens, and OIDC-trusted cloud roles.",
    "Search for network access to listed domains, URLs, and IP addresses, and for /tmp/transformers.pyz on Linux hosts.",
    "Rebuild from clean lockfiles and known-good package versions after cache purge."
  ]
