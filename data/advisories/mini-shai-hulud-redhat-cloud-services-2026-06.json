  "detection_rationale": [
    "The primary source-of-truth signal is namespace-wide npm publish bursts under @redhat-cloud-services, not a third-party article.",
    "Compromised versions declare npm lifecycle execution such as preinstall node index.js.",
    "The JavaScript payload uses AES-GCM encrypted embedded blobs, Bun temp-file staging, dynamic execution, and cleanup.",
    "The payload targets GitHub CLI tokens, GitHub Actions runner secrets, npm tokens, cloud credentials, Kubernetes/Vault material, SSH keys, Git credentials, Docker auth, and wallet files.",
    "The payload supports encrypted outbound exfiltration and GitHub API dead-drop behavior."
  ],
  "remediation": [
    "Block listed @redhat-cloud-services versions in lockfile policy, npm proxy policy, CI allowlists, and artifact caches.",
    "Audit package-lock.json, pnpm-lock.yaml, yarn.lock, npm-shrinkwrap.json, node_modules, CI caches, and container build layers for listed versions.",
    "If an affected version was installed, rotate npm, GitHub, cloud, Kubernetes, Vault, SSH, Docker, and CI/CD credentials exposed to that host or runner.",
    "Hunt for preinstall node index.js, Bun staging under /tmp, gh auth token execution, GitHub API dead-drop writes, and the listed marker strings/hashes.",
    "Rebuild from clean lockfiles and known-good package versions after cache purge."
  ]
