{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secopsai.dev/contracts/secopsai.agent-triage.v1.schema.json",
  "title": "SecOpsAI Agent Triage Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "settings", "summary", "runs", "tuning_proposals"],
  "properties": {
    "schema_version": { "const": "secopsai.agent-triage.v1" },
    "settings": {
      "type": "object",
      "required": ["mode", "selected_model", "min_auto_close_confidence", "min_evidence_refs", "auto_create_tuning_proposals", "auto_activate_tuning"],
      "properties": {
        "mode": { "enum": ["off", "advisory", "guarded"] },
        "selected_model": { "type": "string", "maxLength": 200 },
        "min_auto_close_confidence": { "type": "integer", "minimum": 90, "maximum": 100 },
        "min_evidence_refs": { "type": "integer", "minimum": 1, "maximum": 10 },
        "auto_create_tuning_proposals": { "type": "boolean" },
        "auto_activate_tuning": { "type": "boolean" }
      }
    },
    "summary": { "type": "object" },
    "runs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["run_id", "target_type", "target_id", "status", "reversible", "decision"],
        "properties": {
          "run_id": { "pattern": "^ATR-[A-F0-9]{16}$" },
          "target_type": { "const": "finding" },
          "target_id": { "type": "string", "maxLength": 240 },
          "status": { "enum": ["queued", "awaiting_model", "applied", "recommended", "escalated", "failed", "rolled_back"] },
          "reversible": { "type": "boolean" },
          "decision": { "type": "object" }
        }
      }
    },
    "tuning_proposals": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["proposal_id", "run_id", "finding_id", "target_type", "status", "shadow_metrics"],
        "properties": {
          "proposal_id": { "pattern": "^DTP-[A-F0-9]{16}$" },
          "run_id": { "pattern": "^ATR-[A-F0-9]{16}$" },
          "finding_id": { "type": "string", "maxLength": 240 },
          "target_type": { "enum": ["rule", "threshold"] },
          "status": { "enum": ["shadow_insufficient_data", "shadow_evaluated", "shadow_passed", "active", "rejected", "rolled_back"] },
          "shadow_metrics": { "type": "object" }
        }
      }
    }
  }
}
