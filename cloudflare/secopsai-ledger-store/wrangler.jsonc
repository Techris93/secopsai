{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secopsai-ledger-store",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "routes": [{ "pattern": "ledger.secopsai.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // Secret: LEDGER_STORE_TOKEN (shared with the GitHub Actions runner).
  "r2_buckets": [{ "binding": "LEDGER", "bucket_name": "secopsai-research-ledger" }],
  // Validates runner bridge tokens during the one-time ledger migration.
  "services": [{ "binding": "CORE", "service": "secopsai-core-edge" }],
  "vars": { "LEDGER_MIGRATION_OPEN": "false" },
  // Crons (secret GITHUB_DISPATCH_TOKEN, Actions read/write on
  // Techris93/secopsai only): research worker every 30 minutes, the
  // popular-package fast lane every minute, watchlist refresh daily.
  "triggers": { "crons": ["7,37 * * * *", "* * * * *", "17 3 * * *"] }
}
